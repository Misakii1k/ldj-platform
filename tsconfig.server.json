{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "paths": {
      "@ldj/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@ldj/game-undercover/manifest": [
        "./packages/games/undercover/shared/manifest.ts"
      ],
      "@ldj/game-undercover/server": [
        "./packages/games/undercover/server/index.ts"
      ],
      "@ldj/game-uno/server": [
        "./packages/games/uno/server/index.ts"
      ],
      "@ldj/game-landlord/server": [
        "./packages/games/landlord/server/index.ts"
      ],
      "@ldj/game-werewolf/server": [
        "./packages/games/werewolf/server/index.ts"
      ],
      "@ldj/game-durian/server": [
        "./packages/games/durian/server/index.ts"
      ],
      "@ldj/game-loveletter/server": [
        "./packages/games/loveletter/server/index.ts"
      ]
    }
  },
  "include": [
    "packages/shared/src/**/*.ts",
    "packages/shared/tests/**/*.ts",
    "packages/server/src/**/*.ts",
    "packages/server/tests/**/*.ts",
    "packages/games/*/shared/**/*.ts",
    "packages/games/*/server/**/*.ts",
    "packages/games/*/tests/**/*.ts"
  ]
}
