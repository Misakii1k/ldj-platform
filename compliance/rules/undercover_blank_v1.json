    },
    {
      "clauseId": "UNDERCOVER-BLANK-FINAL-001",
      "sourceSection": "Final guess trigger and reveal (lines 791–792)",
      "sourceText": "If a blank who never guessed is voted out, open one 30-second final guess; in immediate-reveal mode reveal the blank identity before this phase, and otherwise preserve the configured reveal timing.",
