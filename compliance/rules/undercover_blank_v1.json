      "sourceSection": "Active guess opportunity (lines 788–789)",
      "sourceText": "The blank has one total secret guess opportunity and may use it while alive during speaking, ordinary voting, or runoff voting after word reveal, but not during settlement.",
      "transitionIds": ["undercover.blank.guess.initialize_single_unused_opportunity", "undercover.blank.guess.submit_active_secret_guess", "undercover.blank.guess.freeze_submission_eligibility", "undercover.blank.guess.reject_phase_or_settlement_submission"],
      "plannedTestIds": ["undercover_blank_has_exactly_one_guess_opportunity_test", "undercover_blank_can_guess_in_each_approved_active_phase_test", "undercover_blank_guess_is_secret_test", "undercover_blank_cannot_guess_before_speaking_or_during_settlement_test", "undercover_blank_second_guess_is_rejected_test"]
