      "plannedTestIds": ["undercover_blank_registers_separately_from_classic_test", "undercover_blank_is_not_playable_before_acceptance_test", "undercover_blank_rejects_mutable_role_semantics_test"]
    },
    {
      "clauseId": "UNDERCOVER-BLANK-GOV-002",
      "sourceSection": "Undercover locked configuration (line 767)",
      "sourceText": "Lock identity reveal timing and any other permitted pregame identity settings into the opening snapshot for the whole game.",
      "transitionIds": ["undercover.blank.config.lock_reveal_mode_in_snapshot", "undercover.blank.config.reject_midgame_identity_change"],
      "plannedTestIds": ["undercover_blank_reveal_mode_is_snapshot_locked_test", "undercover_blank_midgame_identity_config_change_is_rejected_test"]
    },
    {
