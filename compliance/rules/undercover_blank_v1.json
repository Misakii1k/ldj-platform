      "sourceSection": "Blank win condition (line 787)",
      "sourceText": "When only the blank and one civilian remain, the blank wins immediately unless an earlier valid pending guess still controls finalization.",
      "transitionIds": ["undercover.blank.win.detect_blank_plus_one_civilian", "undercover.blank.result.record_or_finalize_blank_survival_win"],
      "plannedTestIds": ["undercover_blank_wins_at_blank_plus_one_civilian_test", "undercover_blank_does_not_win_before_threshold_test", "undercover_blank_survival_outcome_stays_provisional_when_earlier_guess_pending_test"]
    },
    {
