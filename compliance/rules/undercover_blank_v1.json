      "sourceSection": "Active guess outcome (line 790)",
      "sourceText": "An active correct guess wins immediately according to its submission time; an active wrong guess eliminates the blank immediately and consumes the opportunity permanently.",
      "transitionIds": ["undercover.blank.guess.apply_active_equivalent_win", "undercover.blank.guess.apply_active_not_equivalent_elimination", "undercover.blank.guess.consume_opportunity_permanently"],
