      "clauseId": "UNDERCOVER-BLANK-ASYNC-002",
      "sourceSection": "Submission-time trace and provisional override (line 796)",
      "sourceText": "Freeze eligibility and ordering at submission; later ordinary outcomes remain provisional, and an earlier valid equivalent result overrides any provisional ordinary result produced after submission.",
      "transitionIds": ["undercover.blank.guess.freeze_submission_sequence_and_eligibility", "undercover.blank.result.record_provisional_ordinary_outcome", "undercover.blank.result.override_provisional_with_earlier_equivalent_guess", "undercover.blank.result.finalize_after_pending_guess_resolves"],
      "plannedTestIds": ["undercover_blank_submission_freezes_eligibility_and_sequence_test", "undercover_blank_pending_guess_makes_later_ordinary_result_provisional_test", "undercover_blank_earlier_equivalent_guess_overrides_provisional_result_test", "undercover_blank_wrong_guess_confirms_or_continues_ordinary_outcome_test"]
    },
    {
      "clauseId": "UNDERCOVER-BLANK-TASK-001",
      "sourceSection": "External task recovery policy (line 680)",
      "sourceText": "Give every adjudication task a unique taskId, discard results arriving after final settlement, resume unfinished tasks after restart without consuming another guess, and never call providers again during event replay.",
      "transitionIds": ["undercover.blank.task.assign_unique_id", "undercover.blank.task.ignore_result_after_final", "undercover.blank.task.resume_after_restart", "undercover.blank.task.preserve_single_opportunity_on_recovery", "undercover.blank.task.suppress_provider_call_on_replay"],
      "plannedTestIds": ["undercover_blank_adjudication_task_id_is_unique_test", "undercover_blank_late_result_after_final_is_ignored_test", "undercover_blank_restart_resumes_task_without_second_opportunity_test", "undercover_blank_event_replay_makes_zero_provider_calls_test"]
    },
    {
      "clauseId": "UNDERCOVER-BLANK-TASK-002",
      "sourceSection": "Approved adjudication retention boundary",
      "sourceText": "Persist plaintext answer and guess only while needed by a pending task; after the adjudication result is applied, erase both plaintexts and retain only digests, classification, and bounded audit metadata.",
      "transitionIds": ["undercover.blank.task.persist_minimum_pending_plaintext", "undercover.blank.task.erase_plaintext_after_result_applied", "undercover.blank.task.retain_digest_verdict_and_bounded_audit"],
      "plannedTestIds": ["undercover_blank_pending_task_persists_only_required_plaintext_test", "undercover_blank_applied_task_erases_answer_and_guess_plaintext_test", "undercover_blank_applied_task_retains_only_bounded_audit_metadata_test"]
