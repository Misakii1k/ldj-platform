  "differences": [
    {
      "differenceId": "UNDERCOVER-BLANK-DIFF-001",
      "classification": "CHANGE_RULESET",
      "baselineRulesetId": "undercover_classic_v1",
      "baselineBehavior": "Classic assigns one or two word-bearing undercover players alongside civilians.",
      "targetBehavior": "Blank mode assigns exactly one no-word blank, no word-bearing undercover, and one shared civilian word to everyone else.",
      "relatedClauseIds": ["UNDERCOVER-BLANK-ROLE-001", "UNDERCOVER-BLANK-ROLE-002"]
    },
    {
      "differenceId": "UNDERCOVER-BLANK-DIFF-002",
      "classification": "KEEP_COMPAT",
      "baselineRulesetId": "undercover_classic_v1",
      "baselineBehavior": "The compatibility engine supports 4–12 players and server-timed speaking and ballots.",
      "targetBehavior": "Retain the 4–12 player range and reusable ordinary speaking/ballot flow while changing blank-specific outcomes.",
      "relatedClauseIds": ["UNDERCOVER-BLANK-SETUP-001", "UNDERCOVER-BLANK-ASYNC-001"]
    },
    {
      "differenceId": "UNDERCOVER-BLANK-DIFF-003",
      "classification": "CHANGE_RULESET",
      "baselineRulesetId": "undercover_classic_v1",
      "baselineBehavior": "Classic has no secret word-guess opportunity or asynchronous adjudication.",
      "targetBehavior": "Add one active-or-final guess opportunity, normalization, exact/main/fallback adjudication, async continuation, and provisional-result override.",
      "relatedClauseIds": ["UNDERCOVER-BLANK-GUESS-001", "UNDERCOVER-BLANK-GUESS-002", "UNDERCOVER-BLANK-FINAL-001", "UNDERCOVER-BLANK-ADJ-001", "UNDERCOVER-BLANK-ADJ-002", "UNDERCOVER-BLANK-ASYNC-001", "UNDERCOVER-BLANK-ASYNC-002"]
    }
  ],
  "clauses": [
