      "plannedTestIds": ["undercover_blank_voted_out_unused_opportunity_opens_final_guess_test", "undercover_blank_final_guess_deadline_is_thirty_seconds_test", "undercover_blank_immediate_mode_reveals_identity_before_final_guess_test", "undercover_blank_delayed_mode_does_not_reveal_identity_early_test", "undercover_blank_no_final_guess_after_active_submission_test"]
    },
    {
      "clauseId": "UNDERCOVER-BLANK-FINAL-002",
      "sourceSection": "Approved blank digital boundary",
      "sourceText": "The final guess may be submitted once or explicitly skipped; timeout or skip is wrong, and the rule bot never actively guesses and skips its final chance without receiving the answer.",
      "transitionIds": ["undercover.blank.final.submit_once", "undercover.blank.final.skip_as_incorrect", "undercover.blank.final.timeout_as_incorrect", "undercover.blank.bot.never_submit_active_guess", "undercover.blank.bot.skip_final_without_answer"],
      "plannedTestIds": ["undercover_blank_final_guess_submits_once_test", "undercover_blank_final_skip_is_incorrect_test", "undercover_blank_final_timeout_is_incorrect_test", "undercover_blank_rule_bot_never_actively_guesses_test", "undercover_blank_rule_bot_skips_final_without_standard_answer_test"]
    },
    {
      "clauseId": "UNDERCOVER-BLANK-NORM-001",
      "sourceSection": "Guess normalization (line 793) and approved normalization policy",
      "sourceText": "Under blank-normalization-v1 apply NFC, trim outer whitespace, collapse Unicode whitespace to one ASCII space, and lowercase Latin letters while retaining punctuation and making no simplified/traditional conversion or local synonym inference.",
      "transitionIds": ["undercover.blank.normalization.apply_nfc", "undercover.blank.normalization.trim_outer_whitespace", "undercover.blank.normalization.collapse_unicode_whitespace", "undercover.blank.normalization.lowercase_latin", "undercover.blank.normalization.retain_punctuation", "undercover.blank.normalization.preserve_han_script_form"],
      "plannedTestIds": ["blank_normalization_v1_applies_nfc_test", "blank_normalization_v1_trims_and_collapses_unicode_whitespace_test", "blank_normalization_v1_lowercases_latin_test", "blank_normalization_v1_retains_punctuation_test", "blank_normalization_v1_does_not_convert_simplified_traditional_test", "blank_normalization_v1_does_not_infer_synonyms_test"]
    },
    {
      "clauseId": "UNDERCOVER-BLANK-NORM-002",
      "sourceSection": "Approved normalization input boundary",
      "sourceText": "Accept normalized guess input only at 1–64 Unicode code points and reject all control characters and newlines.",
      "transitionIds": ["undercover.blank.normalization.count_unicode_code_points", "undercover.blank.normalization.reject_empty_or_over_64", "undercover.blank.normalization.reject_controls_or_newlines"],
      "plannedTestIds": ["blank_normalization_v1_accepts_one_to_sixty_four_code_points_test", "blank_normalization_v1_rejects_empty_input_test", "blank_normalization_v1_rejects_over_sixty_four_code_points_test", "blank_normalization_v1_counts_non_bmp_as_one_code_point_test", "blank_normalization_v1_rejects_control_characters_and_newlines_test"]
    },
    {
      "clauseId": "UNDERCOVER-BLANK-ADJ-001",
      "sourceSection": "Guess adjudication (lines 793–794) and external model failure policy (lines 660–678)",
      "sourceText": "After normalization, exact equality is equivalent; otherwise call the main model, and call an independent fallback only when the main result is uncertain or fails. Only equivalent is correct; no explicit equivalent after fallback is wrong.",
      "transitionIds": ["undercover.blank.adjudication.resolve_local_exact", "undercover.blank.adjudication.invoke_main", "undercover.blank.adjudication.invoke_independent_fallback_on_nonfinal", "undercover.blank.adjudication.map_only_equivalent_to_correct", "undercover.blank.adjudication.fail_closed_as_wrong"],
      "plannedTestIds": ["undercover_blank_local_exact_match_is_equivalent_without_provider_test", "undercover_blank_nonexact_invokes_main_provider_test", "undercover_blank_main_uncertain_or_failure_invokes_independent_fallback_test", "undercover_blank_main_definite_not_equivalent_does_not_invoke_fallback_test", "undercover_blank_only_equivalent_is_correct_test", "undercover_blank_two_nonfinal_provider_results_are_wrong_test"]
    },
    {
      "clauseId": "UNDERCOVER-BLANK-ADJ-002",
      "sourceSection": "External adjudication privacy policy (lines 669–676) and approved provider boundary",
      "sourceText": "Providers receive only the normalized standard answer, normalized guess, and versioned instructions, with structured timeout-bound output; the fallback cannot see the main verdict, and credentials, headers, chat, room, nickname, role, ballot, and other secrets are excluded from requests and logs.",
      "transitionIds": ["undercover.blank.adjudication.build_minimal_provider_payload", "undercover.blank.adjudication.enforce_structured_timeout_output", "undercover.blank.adjudication.isolate_fallback_from_main", "undercover.blank.adjudication.redact_credentials_headers_and_game_secrets"],
      "plannedTestIds": ["undercover_blank_provider_payload_contains_only_approved_fields_test", "undercover_blank_provider_output_is_structured_and_timeout_bounded_test", "undercover_blank_fallback_cannot_observe_main_verdict_test", "undercover_blank_provider_logs_exclude_credentials_headers_and_game_secrets_test"]
    },
    {
      "clauseId": "UNDERCOVER-BLANK-ASYNC-001",
      "sourceSection": "Async continuation (line 795)",
      "sourceText": "An adjudication task runs outside the room transaction and does not pause ordinary speaking, voting, or runoff flow while its result is pending.",
      "transitionIds": ["undercover.blank.adjudication.enqueue_outside_room_transaction", "undercover.blank.flow.continue_while_guess_pending"],
      "plannedTestIds": ["undercover_blank_pending_adjudication_does_not_block_speaking_test", "undercover_blank_pending_adjudication_does_not_block_voting_or_runoff_test"]
    },
