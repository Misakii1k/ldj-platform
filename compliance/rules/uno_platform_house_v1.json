    {
      "clauseId": "UNO-HOUSE-PENALTY-003",
      "sourceSection": "Draw chain and challenge (lines 732–733)",
      "sourceText": "A player who cannot or will not stack draws the whole accumulated penalty, is skipped, and cannot play after that penalty draw.",
      "transitionIds": ["uno.house.penalty.accept_accumulated_draw", "uno.house.penalty.skip_accepting_player", "uno.house.penalty.forbid_play_after_penalty_draw"],
