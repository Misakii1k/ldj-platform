    },
    {
      "clauseId": "UNO-HOUSE-PENALTY-001",
      "sourceSection": "Draw chain and challenge (lines 726–728)",
      "sourceText": "+2 may receive +2 or +4, a +4 upgrades a +2 chain to +4-only, and a +4 chain never accepts +2.",
      "transitionIds": ["uno.house.penalty.stack_draw2", "uno.house.penalty.upgrade_draw2_chain_with_draw4", "uno.house.penalty.stack_draw4", "uno.house.penalty.reject_draw2_on_draw4_chain"],
      "plannedTestIds": ["uno_house_draw2_accepts_draw2_test", "uno_house_draw2_accepts_draw4_and_upgrades_chain_test", "uno_house_draw4_accepts_draw4_test", "uno_house_draw4_rejects_draw2_test"]
