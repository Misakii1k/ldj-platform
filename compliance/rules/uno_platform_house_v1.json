    {
      "clauseId": "UNO-HOUSE-PENALTY-005",
      "sourceSection": "Draw chain and challenge (line 736)",
      "sourceText": "Both +4 and +2 response windows last 5 seconds; expiry automatically accepts the accumulated penalty.",
