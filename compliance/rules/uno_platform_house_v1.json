  "differences": [
    {
      "differenceId": "UNO-DIFF-001",
      "classification": "KEEP_COMPAT",
      "baselineRulesetId": "uno-legacy-platform-v1-d1",
      "baselineBehavior": "A legal play is determined from color, face, or wild status, and wild cards require a declared color.",
      "targetBehavior": "Retain the legacy card-matching and declared-color compatibility core as the base legality rule.",
      "relatedClauseIds": ["UNO-HOUSE-BASE-001"]
    },
    {
      "differenceId": "UNO-DIFF-002",
      "classification": "CHANGE_RULESET",
      "baselineRulesetId": "uno-legacy-platform-v1-d1",
      "baselineBehavior": "After drawing, only the drawn-state flow is represented and the legacy bot may play a legal card or pass.",
      "targetBehavior": "After drawing, if there are no playable cards, turn automatically advances to the next player; if playable cards exist, the player retains the turn to choose any legal card in hand or pass.",
      "relatedClauseIds": ["UNO-HOUSE-BASE-001"]
    },
    {
      "differenceId": "UNO-DIFF-003",
      "classification": "CHANGE_RULESET",
      "baselineRulesetId": "uno-legacy-platform-v1-d1",
      "baselineBehavior": "There is no authoritative 15-second ordinary-turn timeout or mild auto-play transition.",
      "targetBehavior": "Add the 15-second timeout, conservative legal-card selection, no-legal-card auto-draw, and atomic automatic UNO declaration.",
      "relatedClauseIds": ["UNO-HOUSE-BASE-002", "UNO-HOUSE-BASE-003"]
    },
    {
      "differenceId": "UNO-DIFF-004",
      "classification": "KEEP_COMPAT",
      "baselineRulesetId": "uno-legacy-platform-v1-d1",
      "baselineBehavior": "In two-player play, reverse advances two seats and therefore acts as skip.",
      "targetBehavior": "Retain reverse-as-skip for two-player individual mode.",
      "relatedClauseIds": ["UNO-HOUSE-BASE-004"]
    },
    {
      "differenceId": "UNO-DIFF-005",
      "classification": "REMOVE_PLAYABLE",
      "baselineRulesetId": "uno-legacy-platform-v1-d1",
      "baselineBehavior": "A player may call UNO only after reaching one card, with no pre-call intent or missed-call race.",
      "targetBehavior": "Do not expose the legacy one-card call flow as the house ruleset; replace it with pre-call, supplement, and catch-race transitions.",
      "relatedClauseIds": ["UNO-HOUSE-UNO-001", "UNO-HOUSE-UNO-002", "UNO-HOUSE-UNO-003", "UNO-HOUSE-UNO-004"]
    },
    {
      "differenceId": "UNO-DIFF-006",
      "classification": "CHANGE_RULESET",
      "baselineRulesetId": "uno-legacy-platform-v1-d1",
      "baselineBehavior": "A pending draw must be accepted; draw penalties do not stack and +4 has no challenge evidence or challenge action.",
      "targetBehavior": "Add directional +2/+4 stacking, challenge eligibility closure rules, fixed response windows, and challenge outcomes.",
      "relatedClauseIds": ["UNO-HOUSE-PENALTY-001", "UNO-HOUSE-PENALTY-002", "UNO-HOUSE-PENALTY-003", "UNO-HOUSE-PENALTY-004", "UNO-HOUSE-PENALTY-005"]
    },
    {
      "differenceId": "UNO-DIFF-007",
      "classification": "REMOVE_PLAYABLE",
      "baselineRulesetId": "uno-legacy-platform-v1-d1",
      "baselineBehavior": "Playing any last card, including +2 or +4, ends the game before the next player receives a terminal penalty.",
      "targetBehavior": "Do not carry that terminal behavior into the house ruleset; settle a fixed terminal draw before round scoring.",
      "relatedClauseIds": ["UNO-HOUSE-TERMINAL-001"]
    },
    {
      "differenceId": "UNO-DIFF-008",
      "classification": "REMOVE_PLAYABLE",
      "baselineRulesetId": "uno-legacy-platform-v1-d1",
      "baselineBehavior": "The legacy result contains only the first player who empties a hand and has no hand-point ranking, teams, rounds, or match ledger.",
      "targetBehavior": "Replace winner-only settlement with card scoring, competition ranking, four-player teams, and 1/3/5/7-round cumulative low-score results.",
      "relatedClauseIds": ["UNO-HOUSE-SCORE-001", "UNO-HOUSE-SCORE-002", "UNO-HOUSE-TEAM-001", "UNO-HOUSE-TEAM-002", "UNO-HOUSE-MATCH-001", "UNO-HOUSE-MATCH-002"]
    },
    {
      "differenceId": "UNO-DIFF-009",
      "classification": "CHANGE_RULESET",
      "baselineRulesetId": "uno-legacy-platform-v1-d1",
      "baselineBehavior": "Initialization searches for a number card as the first discard and falls back to red for a wild.",
      "targetBehavior": "Allow any first discard, suppress its effect, and use deterministic randomness to choose a color for wild or +4.",
      "relatedClauseIds": ["UNO-HOUSE-DECK-001"]
    },
    {
      "differenceId": "UNO-DIFF-010",
      "classification": "KEEP_COMPAT",
      "baselineRulesetId": "uno-legacy-platform-v1-d1",
      "baselineBehavior": "When the draw pile is empty, the top discard is retained and recyclable discards are shuffled into the draw pile.",
      "targetBehavior": "Retain top-discard preservation and deterministic recycling before considering deck expansion.",
      "relatedClauseIds": ["UNO-HOUSE-DECK-002"]
    },
    {
      "differenceId": "UNO-DIFF-011",
      "classification": "REMOVE_PLAYABLE",
      "baselineRulesetId": "uno-legacy-platform-v1-d1",
      "baselineBehavior": "When no cards can be recycled, a requested draw may complete only partially or draw zero; total cards remain fixed at 108.",
      "targetBehavior": "Remove partial-draw behavior from the house ruleset by adding and shuffling complete 108-card generations until the draw can finish.",
      "relatedClauseIds": ["UNO-HOUSE-DECK-003", "UNO-HOUSE-DECK-004"]
    },
    {
      "differenceId": "UNO-DIFF-012",
      "classification": "CHANGE_RULESET",
      "baselineRulesetId": "uno-legacy-platform-v1-d1",
      "baselineBehavior": "The manifest limits the compatibility implementation to 2–6 players without an individual/team mode distinction.",
      "targetBehavior": "Individual mode supports 2–10 players, while team mode is exactly four players in alternating seats.",
      "relatedClauseIds": ["UNO-HOUSE-SCORE-002", "UNO-HOUSE-TEAM-001"]
    }
  ],
  "clauses": [
    {
      "clauseId": "UNO-HOUSE-GOV-001",
      "sourceSection": "UNO platform ruleset introduction (lines 695–699)",
      "sourceText": "Treat this ruleset as a separately named platform variant, never as an official or exact standard ruleset.",
      "transitionIds": ["uno.house.ruleset.lock_identity", "uno.house.admission.reject_standard_claim"],
      "plannedTestIds": ["uno_house_identity_is_platform_variant_test", "uno_house_rejects_official_standard_label_test"]
    },
    {
      "clauseId": "UNO-HOUSE-GOV-002",
      "sourceSection": "UNO platform ruleset introduction (lines 699–701)",
      "sourceText": "Lock only mapped rules and explicit pregame snapshot configuration; undecided boundaries block admission, semantic changes require versioning, and legacy remains the compatibility baseline until all gates pass.",
      "transitionIds": ["uno.house.config.lock_snapshot", "uno.house.admission.fail_closed_unmapped_rule", "uno.house.version.reject_in_place_semantic_change", "uno.house.registry.preserve_legacy_baseline"],
      "plannedTestIds": ["uno_house_locks_explicit_config_in_snapshot_test", "uno_house_unmapped_boundary_blocks_admission_test", "uno_house_semantic_change_requires_new_ruleset_id_test", "uno_house_does_not_replace_legacy_before_gates_test"]
    },
    {
      "clauseId": "UNO-HOUSE-GOV-003",
      "sourceSection": "UNO migration requirement (line 701)",
      "sourceText": "Classify every legacy-to-house difference as KEEP_COMPAT, CHANGE_RULESET, or REMOVE_PLAYABLE; legacy golden replay proves compatibility only.",
      "transitionIds": ["uno.house.trace.validate_legacy_differences", "uno.house.admission.separate_compatibility_from_correctness"],
      "plannedTestIds": ["uno_house_difference_table_is_complete_and_closed_enum_test", "uno_house_legacy_golden_is_not_house_correctness_evidence_test"]
    },
    {
      "clauseId": "UNO-HOUSE-BASE-001",
      "sourceSection": "Base turns (line 705)",
      "sourceText": "After drawing, the current player may play any card in hand that is legal under the current color or face rule.",
      "transitionIds": ["uno.house.turn.draw_one", "uno.house.turn.play_any_legal_after_draw"],
      "plannedTestIds": ["uno_house_after_draw_can_play_preexisting_legal_card_test", "uno_house_after_draw_rejects_illegal_card_test"]
    },
    {
      "clauseId": "UNO-HOUSE-BASE-002",
      "sourceSection": "Base turns (lines 706–708)",
      "sourceText": "At the 15-second ordinary-turn deadline, mild auto-play chooses a legal card by conservative priority; if none exists it draws one and ends without a follow-up play.",
      "transitionIds": ["uno.house.turn.schedule_ordinary_deadline_15s", "uno.house.timeout.choose_conservative_legal_card", "uno.house.timeout.draw_one_and_end_turn"],
      "plannedTestIds": ["uno_house_ordinary_turn_timeout_is_15_seconds_test", "uno_house_timeout_uses_conservative_legal_priority_test", "uno_house_timeout_without_legal_card_draws_and_does_not_play_test"]
    },
    {
      "clauseId": "UNO-HOUSE-BASE-003",
      "sourceSection": "Base turns (line 709)",
      "sourceText": "If mild auto-play leaves exactly one card, the card play and UNO declaration commit atomically.",
      "transitionIds": ["uno.house.timeout.play_and_auto_call_uno_atomic"],
      "plannedTestIds": ["uno_house_timeout_one_card_remainder_auto_calls_uno_atomically_test", "uno_house_timeout_non_one_card_remainder_does_not_auto_call_test"]
    },
    {
      "clauseId": "UNO-HOUSE-BASE-004",
      "sourceSection": "Base turns (line 710)",
      "sourceText": "In two-player individual mode, reverse skips the opponent and returns action to its player.",
      "transitionIds": ["uno.house.turn.apply_two_player_reverse_as_skip"],
      "plannedTestIds": ["uno_house_two_player_reverse_skips_opponent_test", "uno_house_multiplayer_reverse_changes_direction_without_extra_skip_test"]
    },
    {
      "clauseId": "UNO-HOUSE-UNO-001",
      "sourceSection": "UNO declaration (lines 714–715)",
      "sourceText": "A player with exactly two cards may pre-call UNO only after selecting a legal play; the pre-call lasts for that turn and cannot be cancelled.",
      "transitionIds": ["uno.house.uno.set_precall_for_selected_legal_card", "uno.house.uno.expire_precall_at_turn_end", "uno.house.uno.reject_precall_cancel"],
      "plannedTestIds": ["uno_house_precall_requires_two_cards_and_legal_selection_test", "uno_house_precall_expires_after_current_turn_test", "uno_house_precall_cannot_be_cancelled_test"]
    },
    {
      "clauseId": "UNO-HOUSE-UNO-002",
      "sourceSection": "UNO declaration (line 716)",
      "sourceText": "After pre-calling, selection may move among legal cards; illegal cards remain visible but disabled.",
      "transitionIds": ["uno.house.uno.change_precall_legal_selection", "uno.house.view.expose_illegal_card_as_disabled"],
      "plannedTestIds": ["uno_house_precall_can_switch_between_legal_cards_test", "uno_house_precall_illegal_cards_remain_visible_and_unselectable_test"]
    },
    {
      "clauseId": "UNO-HOUSE-UNO-003",
      "sourceSection": "UNO declaration (lines 717–720)",
      "sourceText": "Without a pre-call, reaching one card opens a 5-second race in which the player may supplement the call and others may catch the highlighted target; server transaction order decides, a successful catch draws two, and an incorrect catch is unpenalized.",
      "transitionIds": ["uno.house.uno.open_missed_call_window_5s", "uno.house.uno.submit_supplement", "uno.house.uno.submit_catch", "uno.house.uno.resolve_race_by_commit_order", "uno.house.uno.apply_successful_catch_draw_two", "uno.house.uno.ignore_incorrect_catch"],
      "plannedTestIds": ["uno_house_missing_precall_opens_five_second_race_test", "uno_house_supplement_wins_when_committed_first_test", "uno_house_catch_wins_when_committed_first_and_draws_two_test", "uno_house_wrong_catch_has_no_penalty_test", "uno_house_catch_view_highlights_target_with_audio_cue_test"]
    },
    {
      "clauseId": "UNO-HOUSE-UNO-004",
      "sourceSection": "UNO declaration (lines 721–722)",
      "sourceText": "The next turn runs concurrently; its effective play or draw closes the race early, while an untouched 5-second expiry closes it without penalty.",
      "transitionIds": ["uno.house.uno.run_next_turn_during_race", "uno.house.uno.close_window_on_next_effective_action", "uno.house.uno.expire_window_without_penalty"],
