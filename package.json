{
  "name": "ldj-platform",
  "version": "0.4.0",
  "private": true,
  "description": "局域网桌游平台（聚乐桌：多游戏目录 + 谁是卧底 R1 基线）",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client",
    "packages/games/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json && tsc -p packages/client/tsconfig.json",
    "lint": "eslint .",
    "test": "tsx --test \"packages/**/tests/**/*.test.ts\" && node --test scripts/tests/**/*.test.mjs",
    "compliance:d1": "node scripts/d1-compliance.mjs .",
    "baseline:d1": "tsx scripts/generate-d1-baselines.ts",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install chromium",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run compliance:d1 && npm run build && npm run test:e2e",
    "dev:server": "node packages/server/src/index.ts",
    "perf:load": "node packages/server/scripts/perf.mjs",
    "build": "npm run build -w @ldj/client",
    "start:prod": "node packages/server/src/index.ts",
    "host": "node scripts/start-host-gui.mjs",
    "build:host-payload": "node scripts/build-server-bundle.mjs && node scripts/fetch-node-runtime.mjs",
    "build:apk": "npm run build && npm run build:host-payload && cd packages/client && npx cap copy android && cd android && .\\gradlew.bat assembleDebug",
    "build:apk:release": "npm run build && npm run build:host-payload && cd packages/client && npx cap copy android && cd android && .\\gradlew.bat assembleRelease",
    "sync:apk": "cd packages/client && npx cap copy android"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.32.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
