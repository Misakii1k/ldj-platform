{
  "name": "@lan-party/server",
  "version": "0.2.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-assets.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --root ../.. packages/server/test --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --root ../.. packages/server/test/gateway/app.integration.test.ts",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@lan-party/shared": "0.2.0-alpha.1",
    "pino": "9.7.0",
    "qrcode": "1.5.4",
    "ws": "8.21.1",
    "zod": "4.0.17"
  }
}
